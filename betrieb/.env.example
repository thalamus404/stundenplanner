# Vorlage für betrieb/.env auf dem NAS (docs/BETRIEB.md, „Was Silas einmal tun muss“).
# Die echte .env wird NIE committet (.gitignore: .env). Sie liegt im Hauptklon, nicht in einem
# Arbeitsbaum; ops/bauen.sh liest sie von dort.
#
# API-Token mit genau einer Berechtigung: Account → Cloudflare Pages → Edit, nur für dieses Konto.
CLOUDFLARE_API_TOKEN=
# Account-ID aus dem Cloudflare-Dashboard (rechte Spalte der Kontoübersicht)
CLOUDFLARE_ACCOUNT_ID=
# Name des Pages-Projekts (Direct Upload)
PAGES_PROJEKT=stundenplanner
